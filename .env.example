# =============================================================================
# PayFlow — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development (never commit .env.local).
# In Netlify, set the same keys under Site settings → Environment variables.
#
# Rule of thumb:
#   - Anything prefixed NEXT_PUBLIC_ is bundled into the browser. It is
#     visible to anyone using the app. Only put values here that are safe
#     to be public (Firebase's client config is designed to be public — it
#     is protected by Firestore/Storage security rules, not by secrecy).
#   - Anything WITHOUT the NEXT_PUBLIC_ prefix stays server-only and is
#     only readable from Next.js server components, API routes, and
#     Netlify Functions. NEVER reference these in client components.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SIDE — Firebase Web SDK config (safe to expose, see note above)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed if Firebase Analytics is enabled later
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public app metadata (safe to expose)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# SERVER-ONLY — Firebase Admin SDK (Firestore/Auth/Storage admin access)
# -----------------------------------------------------------------------------
# Generate via Firebase Console → Project settings → Service accounts.
# FIREBASE_ADMIN_PRIVATE_KEY should keep its literal \n line breaks; the app
# converts them back to real newlines at runtime (see lib/firebase/admin.ts).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY — Payment providers (placeholders — none wired up yet)
# -----------------------------------------------------------------------------
# PayFlow uses a provider-agnostic PaymentProvider interface (see
# services/payments/). Add real provider keys here only once a provider is
# actually integrated. Do not hard-code a provider before that.
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_PROVIDER_PUBLIC_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# SERVER-ONLY — AI integration (not wired up yet)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY — Misc
# -----------------------------------------------------------------------------
# Secret used to sign/verify internal server tokens, if/when needed.
# APP_SERVER_SECRET=
